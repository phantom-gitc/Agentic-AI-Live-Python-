---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	yolo(yolo)
	paranoia(paranoia)
	evaluator(evaluator)
	wildcard(wildcard)
	judge(judge)
	__end__([<p>__end__</p>]):::last
	__start__ --> yolo;
	evaluator -.-> judge;
	evaluator -.-> wildcard;
	paranoia --> evaluator;
	wildcard --> yolo;
	yolo --> paranoia;
	judge --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
